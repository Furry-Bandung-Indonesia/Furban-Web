/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Surrogate-Control: no-store
  CDN-Cache-Control: no-store

# Hashed assets: browser caches forever (content hash in name), but NO CDN/proxy caching
# (CDN must not cache assets since it may have previously cached a bad HTML response)
/assets/*
  Cache-Control: public, max-age=100, immutable
  Surrogate-Control: no-store
  CDN-Cache-Control: no-store
